# Node
node_modules/
npm-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*.egg-info/
# Local Home Assistant dev venv — не е част от add-on-а и не бива да влиза в репото
.venv/

# OS
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini

# Secrets / runtime state
.env
.env.*
*.local
ADMIN_TOKEN.txt
/data/
.first-run-done

# PGP ключови пакети — private.asc е частният ключ, не влиза в git
PGP_CryptoSAK_keys-*/
**/private.asc
id_rsa*
*.pem
*.pfx

# Build artifacts & releases
release/*
# Инструментите за издаване са код, не артефакт — те трябва да са в хранилището
!release/*.ps1
build/
dist/
*.zip
*.7z
*.exe
*.ico
*.tar.gz

# IDE
.vscode/
.idea/

# Dev dashboard (local)
dashboard-commands.json

# Външни файлове, попаднали в работната папка по погрешка.
# `create link/` дойде на 2026-10-21 с минифицирани content script-ове на
# разширение за браузър (Bitwarden: autofill/fido2) — не е код на add-on-а,
# не се качва в публичното хранилище и не влиза в изданието.
create link/
