{
  "name": "hapi-enterprise",
  "version": "0.69.59",
  "private": true,
  "description": "hAPI Enterprise — документи и портали между Home Assistant и Windows",
  "scripts": {
    "test": "node scripts/test-matrix.cjs",
    "test:once": "node scripts/run-tests.cjs",
    "test:matrix": "node scripts/test-matrix.cjs --attempts=5",
    "audit:gui": "node scripts/audit-gui-compat.cjs",
    "dashboard": "node scripts/dev-dashboard.cjs",
    "sync:local": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/sync-local-addon.ps1",
    "release": "node scripts/build-release.cjs --with-tests && node scripts/verify-release.cjs",
    "release:build": "node scripts/build-release.cjs",
    "release:verify": "node scripts/verify-release.cjs --with-tests",
    "release:export": "node scripts/export-release.cjs",
    "release:haoss": "node scripts/build-haoss.cjs",
    "changelog:addon": "node scripts/sync-addon-changelog.cjs",
    "status": "node scripts/release-status.cjs",
    "status:check": "node scripts/release-status.cjs --check",
    "settings": "node scripts/settings-defaults.cjs",
    "settings:check": "node scripts/settings-defaults.cjs --check",
    "publish:haoss": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/publish-haoss.ps1",
    "audit": "node scripts/pre-push-audit.cjs",
    "lint": "eslint hapi_enterprise tests custom_components scripts --max-warnings=0",
    "lint:baseline": "eslint hapi_enterprise tests custom_components scripts --suppress-all",
    "lint:prune": "eslint hapi_enterprise tests custom_components scripts --prune-suppressions",
    "lint:fix": "eslint hapi_enterprise tests custom_components scripts --fix",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,css,yml,yaml}\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
