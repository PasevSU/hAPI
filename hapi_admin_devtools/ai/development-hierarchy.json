{
  "schemaVersion": 1,
  "authority": {
    "name": "hAPI-DEV AI Development Director",
    "role": "chief-development-orchestrator",
    "scope": [
      "hAPI Enterprise",
      "hAPI Admin DevTools",
      "HA integration",
      "GitHub CI and release artifacts"
    ],
    "goal": "Continuously inventory, classify, plan and validate project improvements",
