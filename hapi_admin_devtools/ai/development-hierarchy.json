      "observe": true,
      "classify": true,
      "plan": true,
      "generateCandidatePatch": "sandbox-only-after-tooling",
      "runTests": "isolated-test-runner-only",
      "createDraftPR": "future-scoped-github-app",
      "merge": false,
      "publishRelease": false,
      "deployToHA": false,
      "modifyProduction": false
    },
    "supervision": "OpenPGP owner approval + deterministic release-gate; the AI never grants itself privileges"
