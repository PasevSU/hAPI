  "workflow": {
    "states": [
      "new",
      "categorized",
      "evidence-collection",
      "planned",
      "reproduced",
      "candidate-ready",
      "variant-a-tested",
      "variant-b-tested",
      "review-ready",
      "approved",
      "staged",
      "released",
      "verified",
      "rolled-back",
      "blocked"
    ],
    "initialState": "new",
    "defaultActions": [
      "classify",
      "inventory",
      "writePlan"
    ],
    "remoteActionsAlwaysRequire": [
      "OpenPGP authorization",
      "CI verification",
      "GitHub scoped rights",
      "external recovery readiness"
    ],
    "noDirectTransitions": [
      "new->released",
      "planned->released",
      "candidate-ready->released"
    ]
  },
  "roles": [
    {
      "id": "director",
      "level": 0,
      "parent": null,
      "owns": "All project development decisions and routing",
      "permissions": [
        "read",
        "plan",
        "delegate"
      ],
      "cannot": [
        "write-production",
        "publish",
        "self-approve"
      ]
    },
    {
      "id": "architecture-agent",
      "level": 1,
      "parent": "director",
      "owns": "Definitions, dependencies and versioned contracts"
    },
    {
      "id": "incident-agent",
      "level": 1,
      "parent": "director",
      "owns": "Defect classification and reproductions"
    },
    {
      "id": "security-agent",
      "level": 1,
      "parent": "director",
      "owns": "Independent threat and authorization assessment"
    },
    {
      "id": "storage-agent",
      "level": 1,
      "parent": "director",
      "owns": "Data integrity and storage safety"
    },
    {
      "id": "portal-agent",
      "level": 1,
      "parent": "director",
      "owns": "Portal features and folder/quarantine rules"
    },
    {
      "id": "frontend-agent",
      "level": 1,
      "parent": "director",
      "owns": "UI and accessibility"
    },
    {
      "id": "performance-agent",
      "level": 1,
      "parent": "director",
      "owns": "Cache measurements and profiling"
    },
    {
      "id": "locale-agent",
      "level": 1,
      "parent": "director",
      "owns": "Language parity and standards"
    },
    {
      "id": "qa-agent",
      "level": 1,
      "parent": "director",
      "owns": "Reproducible independent tests"
    },
    {
      "id": "release-agent",
      "level": 1,
      "parent": "director",
      "owns": "Release eligibility reports"
    },
    {
      "id": "recovery-agent",
      "level": 1,
      "parent": "director",
      "owns": "Restore drills and rollback evidence"
    },
    {
      "id": "knowledge-agent",
      "level": 1,
      "parent": "director",
      "owns": "Historical knowledge and documentation"
    }
  ],
  "teamPolicies": {
    "allTasksMustHave": [
      "id",
      "category",
      "owner",
      "target",
      "risk",
      "status",
      "source",
      "createdAt",
      "plan",
      "evidence"
    ],
    "multiCategory": true,
    "highRiskNeedsSecurity": true,
    "productionUpdatesNeedRecovery": true,
    "unclassifiedTaskOwner": "director",
    "confidenceSource": "measured evidence, never model self-rating"
  }
}
